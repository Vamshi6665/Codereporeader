# ── Provider / model configuration ────────────────────────────────────────────
# All optional. If OPENAI_API_KEY is set on the server, users don't need to paste
# a key in the sidebar. If it's unset, the app uses whatever key the user enters.

# Your OpenAI API key (recommended: set this in the Vercel dashboard as a secret).
OPENAI_API_KEY=sk-...

# Default model used when the client doesn't specify one.
OPENAI_MODEL=gpt-4o-mini

# Leave blank to use OpenAI directly. To use an OpenAI-compatible provider,
# point this at its endpoint. Examples:
#   GitHub Models:  https://models.github.ai/inference   (use a GitHub PAT as the key)
#   Azure OpenAI:   https://YOUR-RESOURCE.openai.azure.com/openai/deployments/...
# OPENAI_BASE_URL=
