# ─────────────────────────────────────────────────────────────────────────────
# CodeRepoReader configuration. On Vercel, set these in
# Project → Settings → Environment Variables (never commit real values).
# ─────────────────────────────────────────────────────────────────────────────

# Required. Your OpenAI API key. It stays on the server; browsers never see it.
OPENAI_API_KEY=

# Recommended. A GitHub token (fine-grained, read-only access to public repos)
# raises GitHub's limit from 60 to 5,000 requests per hour.
GITHUB_TOKEN=

# Models (defaults shown). Fast is the default mode; Deep reads more code.
# OPENAI_MODEL_FAST=gpt-5.6-luna
# OPENAI_MODEL_DEEP=gpt-5.6-terra
# OPENAI_MODEL_FAST_LABEL=GPT-5.6 Luna
# OPENAI_MODEL_DEEP_LABEL=GPT-5.6 Terra
# REASONING_EFFORT_FAST=low
# REASONING_EFFORT_DEEP=medium

# Optional: any OpenAI-compatible endpoint (Azure OpenAI, OpenRouter, a local server…).
# OPENAI_BASE_URL=

# Per-IP limits (defaults shown). GLOBAL_CHAT_LIMIT_PER_DAY caps the whole site (0 = off).
# CHAT_LIMIT_PER_MINUTE=12
# CHAT_LIMIT_PER_DAY=300
# ANALYZE_LIMIT_PER_10MIN=20
# GLOBAL_CHAT_LIMIT_PER_DAY=0

# Optional: Upstash Redis (Vercel Marketplace) makes rate limits exact across instances.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: extra origins allowed to call the API from a browser (comma-separated).
# ALLOWED_ORIGINS=https://your-custom-domain.com
